diff --git a/service/moderation/checker.go b/service/moderation/checker.go
new file mode 100644
index 0000000..a5a6fb8
--- /dev/null
+++ b/service/moderation/checker.go
@@ -0,0 +1,322 @@
+package moderation
+
+import (
+	"bytes"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"io"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/QuantumNous/new-api/model"
+)
+
+// 检测提示词：按用户要求「判定从宽」，只有明确蓄意才判违规。
+const checkerSystemPrompt = `你是S6AI中转站的内容合规审核员。请判断最后的用户消息（结合简短上下文）是否明确属于以下违规类别之一：
+- nsfw：露骨的色情/性描写内容
+- cyberattack：攻击、入侵、破坏他人网站/系统/账号（爆破、DDoS、漏洞利用、恶意软件、盗号、钓鱼等）
+- reverse_web：逆向、绕过或非法爬取未获授权的网站/平台/接口（绕过风控、模拟登录、破解接口签名等）
+- reverse_commercial：逆向或破解商业软件（脱壳、绕过授权/付费、注册机等）
+
+判定从宽，不要风吹草动就报警：
+- 只有内容明确、蓄意指向上述目的时才判违规，否则一律放行。
+- 学习提问、安全研究、CTF/授权靶场、开源软件或用户自有软件的分析、普通软件逆向、公开数据爬取、文学创作、转述新闻、只提到相关词汇但无实施意图，一律放行。
+- 拿不准就放行。宁可漏判，不可误判。
+只输出一行JSON，不要解释、不要markdown代码块：
+{"violation":null}
+或
+{"violation":"类别代码","confidence":0.0~1.0,"reason":"一句话理由"}`
+
+type EntryInfo struct {
+	Format    string // openai | claude | gemini
+	RequestID string
+	UserID    int
+	Username  string
+	TokenID   int
+	TokenName string
+	Group     string
+	Model     string
+	Messages  []Msg
+}
+
+type checkJob struct {
+	info       EntryInfo
+	transcript string
+	regHashes  []string // 违规时登记的哈希（当前输入 + 历史assistant回复）
+	excerpt    string
+	state      *RequestState
+}
+
+// OnRelayEntry 中转入口：标记对话拦截 + 抽检派发。
+// 返回 (state, refused)。refused=true 时调用方应直接渲染拒绝响应（state.Notice）。
+func OnRelayEntry(c contextSetter, info EntryInfo) (*RequestState, bool) {
+	cfg := Get()
+	if !cfg.Enabled {
+		return nil, false
+	}
+	switch info.Format {
+	case "openai", "claude", "gemini":
+	default:
+		return nil, false
+	}
+	if len(info.Messages) == 0 {
+		return nil, false
+	}
+	mode, _, rateBP, preflight := cfg.PolicyFor(info.Group)
+	if mode == ModeOff {
+		return nil, false
+	}
+
+	// 1) 标记对话检查（排除最后一条消息：当前输入不参与匹配，新对话重试不受影响）
+	gateHashes := HashCandidates(info.Messages, cfg.MinHashLen, true, false)
+	if marked, cat := CheckMarked(info.UserID, gateHashes); marked {
+		display := CategoryNames([]string{cat})
+		hit := &model.ModerationHit{
+			CreatedAt: time.Now().Unix(), RequestId: info.RequestID,
+			UserId: info.UserID, Username: info.Username,
+			TokenId: info.TokenID, TokenName: info.TokenName,
+			GroupName: info.Group, ModelName: info.Model,
+			Category: cat, Reason: "被标记对话的后续请求，未转发上游",
+			Excerpt: Truncate(lastUserText(info.Messages), 500),
+			Action:  "refused",
+		}
+		_ = model.InsertModerationHit(hit)
+		st := &RequestState{
+			Format: info.Format, Mode: mode, Refused: true, Cats: display,
+			Notice: cfg.MarkedNotice(display),
+		}
+		return st, true
+	}
+
+	// 2) 固定概率抽检
+	if !Sampled(rateBP) {
+		return nil, false
+	}
+
+	st := &RequestState{
+		Format:    info.Format,
+		Mode:      mode,
+		VerdictC:  make(chan *Verdict, 1),
+		GraceSec:  cfg.TailGraceSec,
+		Preflight: preflight && mode == ModeEnforce, // 预检仅在拦截模式下生效
+		Done:      make(chan struct{}),
+	}
+	job := checkJob{
+		info:       info,
+		transcript: buildTranscript(info.Messages, cfg.MaxCheckChars),
+		excerpt:    Truncate(lastUserText(info.Messages), 500),
+		state:      st,
+	}
+	// 违规时登记：当前输入（最后一条）+ 历史 assistant 回复
+	if len(info.Messages) > 0 {
+		last := info.Messages[len(info.Messages)-1]
+		if len(last.Text) >= cfg.MinHashLen && (last.Role == "user" || last.Role == "assistant") {
+			job.regHashes = append(job.regHashes, shaHex(last.Text))
+		}
+	}
+	job.regHashes = append(job.regHashes, HashCandidates(info.Messages, cfg.MinHashLen, true, true)...)
+	SetState(c, st)
+	go runCheck(job)
+
+	// 预检：扣住请求等待判定——无违规（或检测失败/超时）放行，违规直接截停（不发上游、不计费）。
+	if st.Preflight {
+		timeout := time.Duration(cfg.PreflightTimeoutSec) * time.Second
+		if timeout <= 0 {
+			timeout = 30 * time.Second
+		}
+		select {
+		case <-st.Done:
+		case <-time.After(timeout):
+			// 超时 fail-open：放行，迟到的判定仍会被审核壳/尾门按既有逻辑处理
+		}
+		if v := st.GetVerdict(); v != nil {
+			st.Refused = true
+			st.Cats = CategoryNames(v.Categories)
+			st.Notice = cfg.BlockNotice(v.Categories)
+			return st, true
+		}
+	}
+	return st, false
+}
+
+func lastUserText(msgs []Msg) string {
+	for i := len(msgs) - 1; i >= 0; i-- {
+		if msgs[i].Role == "user" && msgs[i].Text != "" {
+			return msgs[i].Text
+		}
+	}
+	if len(msgs) > 0 {
+		return msgs[len(msgs)-1].Text
+	}
+	return ""
+}
+
+func buildTranscript(msgs []Msg, maxChars int) string {
+	var parts []string
+	n := 0
+	for i := len(msgs) - 1; i >= 0 && n < 4; i-- {
+		m := msgs[i]
+		if m.Role == "system" || m.Text == "" {
+			continue
+		}
+		role := "用户"
+		if m.Role == "assistant" {
+			role = "AI"
+		}
+		parts = append([]string{role + ": " + Truncate(m.Text, 2000)}, parts...)
+		n++
+	}
+	return Truncate(strings.Join(parts, "\n\n"), maxChars)
+}
+
+func runCheck(job checkJob) {
+	defer func() {
+		if job.state != nil && job.state.Done != nil {
+			close(job.state.Done)
+		}
+	}()
+	cfg := Get()
+	t0 := time.Now()
+	verdict, err := callChecker(cfg, job.transcript)
+	latency := int(time.Since(t0).Milliseconds())
+
+	hit := &model.ModerationHit{
+		CreatedAt: time.Now().Unix(), RequestId: job.info.RequestID,
+		UserId: job.info.UserID, Username: job.info.Username,
+		TokenId: job.info.TokenID, TokenName: job.info.TokenName,
+		GroupName: job.info.Group, ModelName: job.info.Model,
+		Excerpt: job.excerpt, LatencyMs: latency,
+	}
+
+	if err != nil {
+		hit.Action = "error"
+		hit.Reason = Truncate(err.Error(), 300)
+		_ = model.InsertModerationHit(hit)
+		return
+	}
+	if verdict == nil {
+		hit.Action = "clean"
+		_ = model.InsertModerationHit(hit)
+		return
+	}
+
+	hit.Category = strings.Join(verdict.Categories, ",")
+	hit.Confidence = verdict.Confidence
+	hit.Reason = verdict.Reason
+
+	_, deny, _, _ := cfg.PolicyFor(job.info.Group)
+	armed := job.state != nil && job.state.Mode == ModeEnforce &&
+		verdict.Confidence >= cfg.MinConfidence &&
+		len(verdict.Categories) > 0 &&
+		cfg.DenyContains(deny, verdict.Categories[0])
+	if armed {
+		job.state.SetVerdict(verdict)
+		RegisterMark(job.info.UserID, job.regHashes, verdict.Categories[0], verdict.Reason, cfg.MarkTTLDays)
+		hit.Action = "blocked"
+	} else {
+		hit.Action = "observe"
+	}
+	_ = model.InsertModerationHit(hit)
+}
+
+// ==================== 检测模型调用 ====================
+
+type rawVerdict struct {
+	Violation  any      `json:"violation"`
+	Confidence float64  `json:"confidence"`
+	Reason     string   `json:"reason"`
+	Categories []string `json:"categories"`
+}
+
+func callChecker(cfg *Config, transcript string) (*Verdict, error) {
+	ep := cfg.Endpoint
+	if ep.BaseURL == "" || ep.ApiKey == "" || ep.Model == "" {
+		return nil, errors.New("moderation endpoint not configured")
+	}
+	url := strings.TrimRight(ep.BaseURL, "/") + "/chat/completions"
+	payload := map[string]any{
+		"model":       ep.Model,
+		"temperature": 0,
+		"max_tokens":  2048,
+		"messages": []map[string]string{
+			{"role": "system", "content": checkerSystemPrompt},
+			{"role": "user", "content": transcript},
+		},
+	}
+	buf, _ := json.Marshal(payload)
+	timeout := time.Duration(cfg.CheckTimeoutSec) * time.Second
+	if timeout <= 0 {
+		timeout = 60 * time.Second
+	}
+	client := &http.Client{Timeout: timeout}
+	req, err := http.NewRequest("POST", url, bytes.NewReader(buf))
+	if err != nil {
+		return nil, err
+	}
+	req.Header.Set("Content-Type", "application/json")
+	req.Header.Set("Authorization", "Bearer "+ep.ApiKey)
+	resp, err := client.Do(req)
+	if err != nil {
+		return nil, err
+	}
+	defer resp.Body.Close()
+	body, err := io.ReadAll(io.LimitReader(resp.Body, 1<<20))
+	if err != nil {
+		return nil, err
+	}
+	if resp.StatusCode != http.StatusOK {
+		return nil, fmt.Errorf("moderation upstream %d: %s", resp.StatusCode, Truncate(string(body), 200))
+	}
+	var out struct {
+		Choices []struct {
+			Message struct {
+				Content string `json:"content"`
+			} `json:"message"`
+		} `json:"choices"`
+	}
+	if err := json.Unmarshal(body, &out); err != nil {
+		return nil, fmt.Errorf("moderation response unmarshal: %w", err)
+	}
+	if len(out.Choices) == 0 {
+		return nil, errors.New("moderation response empty choices")
+	}
+	return parseVerdictJSON(out.Choices[0].Message.Content)
+}
+
+func parseVerdictJSON(content string) (*Verdict, error) {
+	start := strings.Index(content, "{")
+	end := strings.LastIndex(content, "}")
+	if start < 0 || end <= start {
+		return nil, errors.New("moderation verdict has no JSON object")
+	}
+	var rv rawVerdict
+	if err := json.Unmarshal([]byte(content[start:end+1]), &rv); err != nil {
+		return nil, fmt.Errorf("moderation verdict unmarshal: %w", err)
+	}
+	cats := rv.Categories
+	switch v := rv.Violation.(type) {
+	case string:
+		if v != "" {
+			cats = append(cats, v)
+		}
+	case []any:
+		for _, item := range v {
+			if s, ok := item.(string); ok && s != "" {
+				cats = append(cats, s)
+			}
+		}
+	}
+	// 过滤只保留已知类别
+	var known []string
+	for _, c := range cats {
+		if _, ok := CategoryDisplay[c]; ok {
+			known = append(known, c)
+		}
+	}
+	if len(known) == 0 {
+		return nil, nil // 放行
+	}
+	return &Verdict{Categories: known, Confidence: rv.Confidence, Reason: rv.Reason}, nil
+}
diff --git a/service/moderation/moderation.go b/service/moderation/moderation.go
new file mode 100644
index 0000000..708a6cb
--- /dev/null
+++ b/service/moderation/moderation.go
@@ -0,0 +1,410 @@
+package moderation
+
+import (
+	"crypto/rand"
+	"crypto/sha256"
+	"encoding/hex"
+	"fmt"
+	"strings"
+	"sync"
+	"sync/atomic"
+
+	"github.com/QuantumNous/new-api/relaykit/dto"
+)
+
+// ==================== 类别定义 ====================
+
+const (
+	CatNsfw              = "nsfw"
+	CatCyberattack       = "cyberattack"
+	CatReverseWeb        = "reverse_web"
+	CatReverseCommercial = "reverse_commercial"
+)
+
+var AllCategories = []string{CatNsfw, CatCyberattack, CatReverseWeb, CatReverseCommercial}
+
+var CategoryDisplay = map[string]string{
+	CatNsfw:              "NSFW色情低俗",
+	CatCyberattack:       "网络攻击/入侵",
+	CatReverseWeb:        "逆向未授权网站",
+	CatReverseCommercial: "逆向商业软件破解",
+}
+
+func CategoryNames(cats []string) string {
+	names := make([]string, 0, len(cats))
+	for _, c := range cats {
+		if d, ok := CategoryDisplay[c]; ok {
+			names = append(names, d)
+		} else {
+			names = append(names, c)
+		}
+	}
+	return strings.Join(names, "、")
+}
+
+// ==================== 配置（管理台写入，本包轮询加载） ====================
+
+const (
+	ModeOff     = "off"
+	ModeObserve = "observe"
+	ModeEnforce = "enforce"
+)
+
+type EndpointConfig struct {
+	BaseURL string `json:"base_url"`
+	ApiKey  string `json:"api_key"`
+	Model   string `json:"model"`
+}
+
+type Templates struct {
+	Block  string `json:"block"`
+	Marked string `json:"marked"`
+}
+
+// GroupPolicy 分组策略：指针字段区分「未设置（继承全局）」与「显式设置（含空值）」。
+type GroupPolicy struct {
+	Mode         *string   `json:"mode"`
+	Deny         *[]string `json:"deny"`
+	SampleRateBP *int      `json:"sample_rate_bp"`
+	Preflight    *bool     `json:"preflight"`
+}
+
+type Config struct {
+	Enabled             bool                   `json:"enabled"`
+	Mode                string                 `json:"mode"`
+	SampleRateBP        int                    `json:"sample_rate_bp"`
+	Deny                []string               `json:"deny"`
+	MinConfidence       float64                `json:"min_confidence"`
+	MinHashLen          int                    `json:"min_hash_len"`
+	CheckTimeoutSec     int                    `json:"check_timeout_sec"`
+	Preflight           bool                   `json:"preflight"`
+	PreflightTimeoutSec int                    `json:"preflight_timeout_sec"`
+	TailGraceSec        int                    `json:"tail_grace_sec"`
+	MarkTTLDays         int                    `json:"mark_ttl_days"`
+	MaxCheckChars       int                    `json:"max_check_chars"`
+	Endpoint            EndpointConfig         `json:"endpoint"`
+	Templates           Templates              `json:"templates"`
+	Groups              map[string]GroupPolicy `json:"groups"`
+}
+
+func DefaultConfig() *Config {
+	return &Config{
+		Enabled:             false,
+		Mode:                ModeObserve,
+		SampleRateBP:        500,
+		Deny:                AllCategories,
+		MinConfidence:       0.8,
+		MinHashLen:          24,
+		CheckTimeoutSec:     60,
+		Preflight:           false,
+		PreflightTimeoutSec: 30,
+		TailGraceSec:        3,
+		MarkTTLDays:         7,
+		MaxCheckChars:       6000,
+		Endpoint: EndpointConfig{
+			BaseURL: "https://aiapi.keniis.top/nk/v1",
+			Model:   "glm-5.3-flash",
+		},
+		Templates: Templates{
+			Block:  "【S6AI提示】我们的系统抽样检测到当前对话存在【{category}】问题，已截停当前对话。若有误报请记录并联系站点管理员，并开新对话重试。",
+			Marked: "【S6AI提示】当前对话已被标记存在【{category}】问题，请勿再次请求。若有误报请记录并联系站点管理员，并开新对话重试。",
+		},
+		Groups: map[string]GroupPolicy{},
+	}
+}
+
+var configPtr atomic.Pointer[Config]
+
+func Get() *Config {
+	if p := configPtr.Load(); p != nil {
+		return p
+	}
+	return DefaultConfig()
+}
+
+func (cfg *Config) PolicyFor(group string) (mode string, deny []string, rateBP int, preflight bool) {
+	mode, deny, rateBP = cfg.Mode, cfg.Deny, cfg.SampleRateBP
+	preflight = cfg.Preflight
+	if p, ok := cfg.Groups[group]; ok {
+		if p.Mode != nil && *p.Mode != "" {
+			mode = *p.Mode
+		}
+		if p.Deny != nil {
+			deny = *p.Deny
+		}
+		if p.SampleRateBP != nil && *p.SampleRateBP >= 0 {
+			rateBP = *p.SampleRateBP
+		}
+		if p.Preflight != nil {
+			preflight = *p.Preflight
+		}
+	}
+	return
+}
+
+func (cfg *Config) DenyContains(deny []string, cat string) bool {
+	for _, d := range deny {
+		if d == cat {
+			return true
+		}
+	}
+	return false
+}
+
+func (cfg *Config) BlockNotice(cats []string) string {
+	t := cfg.Templates.Block
+	if t == "" {
+		t = DefaultConfig().Templates.Block
+	}
+	return strings.ReplaceAll(t, "{category}", CategoryNames(cats))
+}
+
+func (cfg *Config) MarkedNotice(cats string) string {
+	t := cfg.Templates.Marked
+	if t == "" {
+		t = DefaultConfig().Templates.Marked
+	}
+	return strings.ReplaceAll(t, "{category}", cats)
+}
+
+// ==================== 请求状态（gin context 传递） ====================
+
+const stateContextKey = "s6_moderation_state"
+
+type Verdict struct {
+	Categories []string `json:"categories"`
+	Confidence float64  `json:"confidence"`
+	Reason     string   `json:"reason"`
+}
+
+type RequestState struct {
+	Format   string // openai | claude | gemini
+	Mode     string
+	VerdictC chan *Verdict
+	Refused  bool   // 入口判定：标记对话，调用方需直接渲染拒绝响应
+	Cats     string // Refused 时的类别展示名
+	Notice   string // Refused 时的提示文案
+
+	SawContent atomic.Bool // 流式：已有内容块转发给客户端
+	TakenOver  atomic.Bool // 流式：审核壳已接管（合成响应，上游应停止）
+
+	mu       sync.Mutex
+	verdict  *Verdict
+	Graced   bool
+	GraceSec int
+
+	Preflight bool          // 预检：入口等待判定后再放行
+	Done      chan struct{} // 检测流程结束信号（含 clean/error，runCheck 收尾关闭）
+
+	ClaudeBlockIndex int // claude 原生流：已见最大 content_block index
+}
+
+func SetState(c contextSetter, st *RequestState) {
+	c.Set(stateContextKey, st)
+}
+
+func StateFrom(c contextGetter) *RequestState {
+	v, ok := c.Get(stateContextKey)
+	if !ok {
+		return nil
+	}
+	st, _ := v.(*RequestState)
+	return st
+}
+
+// contextGetter/contextSetter 用接口避免直接依赖 gin（方便测试）
+type contextGetter interface {
+	Get(key string) (any, bool)
+}
+type contextSetter interface {
+	Set(key string, value any)
+}
+
+// SetVerdict 异步检测结果落地，只接收第一个
+func (s *RequestState) SetVerdict(v *Verdict) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if s.verdict != nil {
+		return
+	}
+	s.verdict = v
+	select {
+	case s.VerdictC <- v:
+	default:
+	}
+}
+
+func (s *RequestState) GetVerdict() *Verdict {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.verdict
+}
+
+// ==================== 消息抽取与哈希 ====================
+
+// Msg 抽取后的对话消息（文本部分）
+type Msg struct {
+	Role string // user | assistant | system
+	Text string
+}
+
+func mediaTexts(parts []dto.MediaContent) string {
+	var b strings.Builder
+	for _, p := range parts {
+		if p.Type == "text" && p.Text != "" {
+			if b.Len() > 0 {
+				b.WriteString("\n")
+			}
+			b.WriteString(p.Text)
+		}
+	}
+	return b.String()
+}
+
+// ExtractMessages 从各格式请求中抽取文本消息（含 system，供上层过滤）
+func ExtractMessages(request dto.Request) []Msg {
+	switch r := request.(type) {
+	case *dto.GeneralOpenAIRequest:
+		var out []Msg
+		for i := range r.Messages {
+			m := &r.Messages[i]
+			out = append(out, Msg{Role: m.Role, Text: mediaTexts(m.ParseContent())})
+		}
+		return out
+	case *dto.ClaudeRequest:
+		var out []Msg
+		for i := range r.Messages {
+			m := &r.Messages[i]
+			parts, err := m.ParseContent()
+			if err != nil {
+				continue
+			}
+			var b strings.Builder
+			for _, p := range parts {
+				if p.Type == "text" && p.Text != nil && *p.Text != "" {
+					if b.Len() > 0 {
+						b.WriteString("\n")
+					}
+					b.WriteString(*p.Text)
+				}
+			}
+			out = append(out, Msg{Role: m.Role, Text: b.String()})
+		}
+		return out
+	case *dto.GeminiChatRequest:
+		var out []Msg
+		for _, c := range r.Contents {
+			var b strings.Builder
+			for _, p := range c.Parts {
+				if p.Text != "" && !p.Thought {
+					if b.Len() > 0 {
+						b.WriteString("\n")
+					}
+					b.WriteString(p.Text)
+				}
+			}
+			role := c.Role
+			out = append(out, Msg{Role: role, Text: b.String()})
+		}
+		return out
+	}
+	return nil
+}
+
+func shaHex(text string) string {
+	sum := sha256.Sum256([]byte(strings.TrimSpace(text)))
+	return hex.EncodeToString(sum[:])
+}
+
+// HashCandidates 返回参与标记匹配的哈希候选。
+// excludeLast=true 时跳过最后一条消息（当前输入不能拿来做入口匹配，否则新对话首句会被误拦）。
+func HashCandidates(msgs []Msg, minLen int, excludeLast bool, assistantOnly bool) []string {
+	if len(msgs) == 0 {
+		return nil
+	}
+	end := len(msgs)
+	if excludeLast {
+		end = len(msgs) - 1
+	}
+	seen := map[string]bool{}
+	var out []string
+	for i := 0; i < end; i++ {
+		m := msgs[i]
+		if assistantOnly && m.Role != "assistant" {
+			continue
+		}
+		if !assistantOnly && m.Role != "assistant" && m.Role != "user" {
+			continue // system 不参与，避免同用户跨对话误连坐
+		}
+		if len(m.Text) < minLen {
+			continue
+		}
+		h := shaHex(m.Text)
+		if !seen[h] {
+			seen[h] = true
+			out = append(out, h)
+		}
+	}
+	return out
+}
+
+// Sampled 固定概率抽检（rateBP 为万分比）
+func Sampled(rateBP int) bool {
+	if rateBP <= 0 {
+		return false
+	}
+	if rateBP >= 10000 {
+		return true
+	}
+	var b [2]byte
+	_, _ = rand.Read(b[:])
+	n := int(b[0])<<8 | int(b[1])
+	return n%10000 < rateBP
+}
+
+func Truncate(s string, max int) string {
+	if max <= 0 || len(s) <= max {
+		return s
+	}
+	return s[:max] + "…"
+}
+
+func ResponseID(prefix string) string {
+	var b [4]byte
+	_, _ = rand.Read(b[:])
+	return fmt.Sprintf("%s-s6mod-%s", prefix, hex.EncodeToString(b[:]))
+}
+
+// ==================== 状态辅助（渲染层使用） ====================
+
+// NoticeTextOf 由判定生成截停提示文案
+func (s *RequestState) NoticeTextOf(v *Verdict) string {
+	if v == nil {
+		return ""
+	}
+	return Get().BlockNotice(v.Categories)
+}
+
+func (s *RequestState) ClaudeBlockIndexHint() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	return s.ClaudeBlockIndex
+}
+
+func (s *RequestState) SetClaudeBlockIndex(idx int) {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	if idx > s.ClaudeBlockIndex {
+		s.ClaudeBlockIndex = idx
+	}
+}
+
+func (s *RequestState) NextClaudeBlockIndex() int {
+	s.mu.Lock()
+	defer s.mu.Unlock()
+	s.ClaudeBlockIndex++
+	return s.ClaudeBlockIndex
+}
+
+// TakenOver 是否已被审核壳接管
+func (s *RequestState) Taken() bool { return s.TakenOver.Load() }
