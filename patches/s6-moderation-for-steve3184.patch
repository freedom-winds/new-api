+package moderation
+
+import (
+	"testing"
+)
+
+func TestParseVerdictJSON(t *testing.T) {
+	cases := []struct {
+		in      string
+		wantNil bool
+		wantCat string
+	}{
+		{`{"violation":null}`, true, ""},
+		{`{"violation":"cyberattack","confidence":0.98,"reason":"爆破"}`, false, "cyberattack"},
+		{"```json\n{\"violation\":\"nsfw\",\"confidence\":1.0,\"reason\":\"露骨\"}\n```", false, "nsfw"},
+		{`前置说明{"violation":["reverse_web"],"confidence":0.9,"reason":"绕过"}尾部`, false, "reverse_web"},
+		{`{"violation":"unknown_cat","confidence":0.9,"reason":"x"}`, true, ""},
+		{`不是json`, true, ""},
+	}
+	for i, c := range cases {
+		v, err := parseVerdictJSON(c.in)
+		if c.wantNil {
+			if v != nil {
+				t.Errorf("case %d: want nil verdict, got %+v (err=%v)", i, v, err)
+			}
+			continue
+		}
+		if err != nil {
+			t.Errorf("case %d: unexpected err %v", i, err)
+			continue
+		}
+		if len(v.Categories) == 0 || v.Categories[0] != c.wantCat {
+			t.Errorf("case %d: want cat %s got %+v", i, c.wantCat, v.Categories)
+		}
+	}
+}
+
+func TestSampled(t *testing.T) {
+	// 10000bp = 必中；0 = 不中；5000bp ≈ 一半
+	if !Sampled(10000) {
+		t.Error("10000bp should always sample")
+	}
+	if Sampled(0) {
+		t.Error("0bp should never sample")
+	}
+	hits := 0
+	for i := 0; i < 10000; i++ {
+		if Sampled(5000) {
+			hits++
+		}
+	}
+	if hits < 4500 || hits > 5500 {
+		t.Errorf("5000bp sampled %d/10000", hits)
+	}
+}
+
+func TestHashCandidatesExcludesLast(t *testing.T) {
+	msgs := []Msg{
+		{Role: "system", Text: "system prompt should never be hashed"},
+		{Role: "user", Text: "第一条用户消息，足够长可以参与哈希计算的内容"},
+		{Role: "assistant", Text: "这是AI的回复，长度也足够参与标记哈希计算"},
+		{Role: "user", Text: "当前这一轮输入，不应当出现在入口匹配候选里"},
+	}
+	gate := HashCandidates(msgs, 10, true, false)
+	if len(gate) != 2 {
+		t.Errorf("gate: want 2 hashes (user+assistant history), got %d", len(gate))
+	}
+	reg := HashCandidates(msgs, 10, true, true)
+	if len(reg) != 1 {
+		t.Errorf("register: want 1 assistant hash, got %d", len(reg))
+	}
+}
+
+func TestPolicyFor(t *testing.T) {
+	cfg := DefaultConfig()
+	cfg.Mode = ModeObserve
+	cfg.SampleRateBP = 500
+	modeStr := ModeEnforce
+	rate := 2000
+	emptyDeny := []string{}
+	pf := true
+	pfOff := false
+	cfg.Groups["vip"] = GroupPolicy{Mode: &modeStr, SampleRateBP: &rate, Preflight: &pf}
+	mode, _, r, pre := cfg.PolicyFor("vip")
+	if mode != ModeEnforce || r != 2000 || !pre {
+		t.Errorf("vip policy: mode=%s rate=%d preflight=%v", mode, r, pre)
+	}
+	// 空分组：继承全局
+	mode, _, r, pre = cfg.PolicyFor("default")
+	if mode != ModeObserve || r != 500 || pre {
+		t.Errorf("default policy: mode=%s rate=%d preflight=%v", mode, r, pre)
+	}
+	// 显式关闭预检可覆盖全局开启
+	cfg.Preflight = true
+	cfg.Groups["nopf"] = GroupPolicy{Preflight: &pfOff}
+	if _, _, _, pre := cfg.PolicyFor("nopf"); pre {
+		t.Errorf("nopf preflight: want false")
+	}
+	// 显式空 deny：覆盖全局（该组全放行）
+	cfg.Groups["lax"] = GroupPolicy{Deny: &emptyDeny}
+	_, deny, _, _ := cfg.PolicyFor("lax")
+	if len(deny) != 0 {
+		t.Errorf("lax deny: want empty, got %v", deny)
+	}
+	// 显式 0 比例：不被全局回退
+	zero := 0
+	cfg.Groups["none"] = GroupPolicy{SampleRateBP: &zero}
+	_, _, r, _ = cfg.PolicyFor("none")
+	if r != 0 {
+		t.Errorf("none rate: want 0, got %d", r)
+	}
+}
+
+func TestNoticeTemplates(t *testing.T) {
+	cfg := DefaultConfig()
+	s := cfg.BlockNotice([]string{CatNsfw, CatCyberattack})
+	want := "【S6AI提示】我们的系统抽样检测到当前对话存在【NSFW色情低俗、网络攻击/入侵】问题，已截停当前对话。若有误报请记录并联系站点管理员，并开新对话重试。"
+	if s != want {
+		t.Errorf("block notice:\n got: %s\nwant: %s", s, want)
+	}
+}
diff --git a/service/moderation/store.go b/service/moderation/store.go
new file mode 100644
index 0000000..12b42cc
--- /dev/null
+++ b/service/moderation/store.go
@@ -0,0 +1,151 @@
+package moderation
+
+import (
+	"encoding/json"
+	"log"
+	"strconv"
+	"sync"
+	"time"
+
+	"github.com/QuantumNous/new-api/model"
+)
+
+// ==================== 标记集（内存 + MySQL 持久化） ====================
+
+type markEntry struct {
+	Category  string
+	ExpiresAt int64
+}
+
+type markStore struct {
+	mu    sync.RWMutex
+	items map[string]markEntry // key: "userID|hash"
+}
+
+var marks = &markStore{items: map[string]markEntry{}}
+
+func markKey(userID int, hash string) string {
+	return strconv.Itoa(userID) + "|" + hash
+}
+
+// CheckMarked 检查该用户是否携带被标记对话的内容哈希
+func CheckMarked(userID int, hashes []string) (marked bool, category string) {
+	now := time.Now().Unix()
+	marks.mu.RLock()
+	defer marks.mu.RUnlock()
+	for _, h := range hashes {
+		if e, ok := marks.items[markKey(userID, h)]; ok && e.ExpiresAt > now {
+			return true, e.Category
+		}
+	}
+	return false, ""
+}
+
+// RegisterMark 登记标记（内存 + DB，重复忽略）
+func RegisterMark(userID int, hashes []string, category string, reason string, ttlDays int) {
+	if len(hashes) == 0 || ttlDays <= 0 {
+		return
+	}
+	now := time.Now().Unix()
+	expires := now + int64(ttlDays)*86400
+	marks.mu.Lock()
+	for _, h := range hashes {
+		k := markKey(userID, h)
+		if old, ok := marks.items[k]; ok && old.ExpiresAt > now {
+			continue
+		}
+		marks.items[k] = markEntry{Category: category, ExpiresAt: expires}
+	}
+	marks.mu.Unlock()
+	// 逐条落库，冲突忽略
+	for _, h := range hashes {
+		_ = model.InsertModerationMark(&model.ModerationMark{
+			UserId:      userID,
+			ContentHash: h,
+			Category:    category,
+			Reason:      reason,
+			Source:      "auto",
+			CreatedAt:   now,
+			ExpiresAt:   expires,
+		})
+	}
+}
+
+// ==================== 配置轮询与启动 ====================
+
+func loadConfigFromDB() *Config {
+	setting, err := model.GetModerationSetting()
+	if err != nil || setting == nil || setting.Config == "" {
+		return nil
+	}
+	cfg := DefaultConfig()
+	if err := json.Unmarshal([]byte(setting.Config), cfg); err != nil {
+		log.Printf("[moderation] config unmarshal failed: %v", err)
+		return nil
+	}
+	return cfg
+}
+
+// Setup 初始化：加载配置与标记集，启动轮询。必须在 DB 初始化之后调用。
+func Setup() {
+	if cfg := loadConfigFromDB(); cfg != nil {
+		configPtr.Store(cfg)
+	}
+	// 装载存量标记
+	if list, err := model.LoadActiveModerationMarks(); err == nil {
+		now := time.Now().Unix()
+		marks.mu.Lock()
+		for _, m := range list {
+			if m.ExpiresAt > now {
+				marks.items[markKey(m.UserId, m.ContentHash)] = markEntry{Category: m.Category, ExpiresAt: m.ExpiresAt}
+			}
+		}
+		marks.mu.Unlock()
+	}
+	go pollLoop()
+	go markCleanupLoop()
+}
+
+func pollLoop() {
+	ticker := time.NewTicker(30 * time.Second)
+	defer ticker.Stop()
+	for range ticker.C {
+		if cfg := loadConfigFromDB(); cfg != nil {
+			configPtr.Store(cfg)
+		}
+		// 重载标记集：管理台解除标记后 ≤30s 生效喵。
+		reloadMarksFromDB()
+	}
+}
+
+func reloadMarksFromDB() {
+	list, err := model.LoadActiveModerationMarks()
+	if err != nil {
+		return
+	}
+	now := time.Now().Unix()
+	fresh := make(map[string]markEntry, len(list))
+	for _, m := range list {
+		if m.ExpiresAt > now {
+			fresh[markKey(m.UserId, m.ContentHash)] = markEntry{Category: m.Category, ExpiresAt: m.ExpiresAt}
+		}
+	}
+	marks.mu.Lock()
+	marks.items = fresh
+	marks.mu.Unlock()
+}
+
+func markCleanupLoop() {
+	ticker := time.NewTicker(1 * time.Hour)
+	defer ticker.Stop()
+	for range ticker.C {
+		now := time.Now().Unix()
+		marks.mu.Lock()
+		for k, e := range marks.items {
+			if e.ExpiresAt <= now {
+				delete(marks.items, k)
+			}
+		}
+		marks.mu.Unlock()
+	}
+}
