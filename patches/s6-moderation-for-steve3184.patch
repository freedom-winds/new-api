@@ -0,0 +1,165 @@
+package model
+
+import (
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+)
+
+// ==================== 内容审核（S6 Moderation）====================
+// 三张表：
+//   - ModerationSetting：单行配置（id=1，JSON），管理台写入，网关轮询加载
+//   - ModerationMark：对话标记集（用户ID + 内容哈希），命中后拦后续同对话请求
+//   - ModerationHit：抽检命中/处置流水，供管理台查询复核
+
+type ModerationSetting struct {
+	Id        int    `json:"id" gorm:"primaryKey"`
+	Config    string `json:"config" gorm:"type:text"`
+	UpdatedAt int64  `json:"updated_at" gorm:"bigint"`
+}
+
+func (ModerationSetting) TableName() string { return "moderation_settings" }
+
+type ModerationMark struct {
+	Id          int    `json:"id" gorm:"primaryKey"`
+	UserId      int    `json:"user_id" gorm:"uniqueIndex:idx_mod_mark_unique,priority:1"`
+	ContentHash string `json:"content_hash" gorm:"type:varchar(64);uniqueIndex:idx_mod_mark_unique,priority:2"`
+	Category    string `json:"category" gorm:"type:varchar(32)"`
+	Reason      string `json:"reason" gorm:"type:text"`
+	Source      string `json:"source" gorm:"type:varchar(16);default:'auto'"`
+	CreatedAt   int64  `json:"created_at" gorm:"bigint"`
+	ExpiresAt   int64  `json:"expires_at" gorm:"bigint;index"`
+}
+
+func (ModerationMark) TableName() string { return "moderation_marks" }
+
+type ModerationHit struct {
+	Id         int     `json:"id" gorm:"primaryKey"`
+	CreatedAt  int64   `json:"created_at" gorm:"bigint;index"`
+	RequestId  string  `json:"request_id" gorm:"type:varchar(64)"`
+	UserId     int     `json:"user_id" gorm:"index"`
+	Username   string  `json:"username" gorm:"type:varchar(64)"`
+	TokenId    int     `json:"token_id"`
+	TokenName  string  `json:"token_name" gorm:"type:varchar(64)"`
+	GroupName  string  `json:"group_name" gorm:"type:varchar(64);index"`
+	ModelName  string  `json:"model_name" gorm:"type:varchar(128)"`
+	Category   string  `json:"category" gorm:"type:varchar(32);index"`
+	Confidence float64 `json:"confidence"`
+	Reason     string  `json:"reason" gorm:"type:text"`
+	Excerpt    string  `json:"excerpt" gorm:"type:text"`
+	Action     string  `json:"action" gorm:"type:varchar(16);index"` // observe | blocked | refused | clean | error
+	Reviewed   int     `json:"reviewed" gorm:"default:0"`            // 0 未复核 1 误报 2 确认违规
+	Note       string  `json:"note" gorm:"type:text"`
+	LatencyMs  int     `json:"latency_ms"`
+}
+
+func (ModerationHit) TableName() string { return "moderation_hits" }
+
+// ---------------- CRUD ----------------
+
+func GetModerationSetting() (*ModerationSetting, error) {
+	var s ModerationSetting
+	err := DB.Where("id = ?", 1).First(&s).Error
+	if err != nil {
+		return nil, err
+	}
+	return &s, nil
+}
+
+func SaveModerationSetting(configJson string) error {
+	now := time.Now().Unix()
+	var count int64
+	DB.Model(&ModerationSetting{}).Where("id = ?", 1).Count(&count)
+	if count == 0 {
+		return DB.Create(&ModerationSetting{Id: 1, Config: configJson, UpdatedAt: now}).Error
+	}
+	return DB.Model(&ModerationSetting{}).Where("id = ?", 1).
+		Updates(map[string]any{"config": configJson, "updated_at": now}).Error
+}
+
+func InsertModerationMark(mark *ModerationMark) error {
+	return DB.Clauses().Create(mark).Error
+}
+
+func DeleteModerationMark(id int) error {
+	return DB.Delete(&ModerationMark{}, id).Error
+}
+
+func ListModerationMarks(limit int, offset int) ([]ModerationMark, int64, error) {
+	var marks []ModerationMark
+	var total int64
+	DB.Model(&ModerationMark{}).Count(&total)
+	err := DB.Order("id desc").Limit(limit).Offset(offset).Find(&marks).Error
+	return marks, total, err
+}
+
+func LoadActiveModerationMarks() ([]ModerationMark, error) {
+	var marks []ModerationMark
+	err := DB.Where("expires_at > ?", time.Now().Unix()).Find(&marks).Error
+	return marks, err
+}
+
+func InsertModerationHit(hit *ModerationHit) error {
+	return DB.Create(hit).Error
+}
+
+type ModerationHitQuery struct {
+	Group    string
+	Category string
+	Action   string
+	UserId   int
+	Reviewed int // -1 = 全部
+	Limit    int
+	Offset   int
+}
+
+func ListModerationHits(q ModerationHitQuery) ([]ModerationHit, int64, error) {
+	tx := DB.Model(&ModerationHit{})
+	if q.Group != "" {
+		tx = tx.Where("group_name = ?", q.Group)
+	}
+	if q.Category != "" {
+		tx = tx.Where("category = ?", q.Category)
+	}
+	if q.Action != "" {
+		tx = tx.Where("action = ?", q.Action)
+	}
+	if q.UserId > 0 {
+		tx = tx.Where("user_id = ?", q.UserId)
+	}
+	if q.Reviewed >= 0 {
+		tx = tx.Where("reviewed = ?", q.Reviewed)
+	}
+	var total int64
+	tx.Count(&total)
+	if q.Limit <= 0 {
+		q.Limit = 50
+	}
+	var hits []ModerationHit
+	err := tx.Order("id desc").Limit(q.Limit).Offset(q.Offset).Find(&hits).Error
+	return hits, total, err
+}
+
+type ModerationDayStat struct {
+	Day      string `json:"day"`
+	Category string `json:"category"`
+	Count    int64  `json:"count"`
+}
+
+func ModerationStats(days int) ([]ModerationDayStat, error) {
+	since := time.Now().AddDate(0, 0, -days).Unix()
+	var stats []ModerationDayStat
+	// 方言自适应的按天聚合（兼容 MySQL / PostgreSQL / SQLite）
+	dayExpr := "DATE(FROM_UNIXTIME(created_at))"
+	switch {
+	case common.UsingMainDatabase(common.DatabaseTypePostgreSQL):
+		dayExpr = "TO_TIMESTAMP(created_at)::date::text"
+	case common.UsingMainDatabase(common.DatabaseTypeSQLite):
+		dayExpr = "DATE(created_at, 'unixepoch')"
+	}
+	err := DB.Model(&ModerationHit{}).
+		Select(dayExpr+" as day, category, COUNT(*) as count").
+		Where("created_at > ? AND action != ?", since, "clean").
+		Group("day, category").Order("day desc").Find(&stats).Error
+	return stats, err
+}
