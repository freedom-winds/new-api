diff --git a/relay/helper/moderation_render.go b/relay/helper/moderation_render.go
new file mode 100644
index 0000000..307a70a
--- /dev/null
+++ b/relay/helper/moderation_render.go
@@ -0,0 +1,283 @@
+package helper
+
+import (
+	"time"
+
+	"github.com/QuantumNous/new-api/common"
+	relaycommon "github.com/QuantumNous/new-api/relay/common"
+	relaytypes "github.com/QuantumNous/new-api/relaykit/types"
+	"github.com/QuantumNous/new-api/service/moderation"
+
+	"github.com/gin-gonic/gin"
+)
+
+// ==================== S6 内容审核渲染层 ====================
+// moderation 包负责判定与状态，本文件负责把「S6AI提示」按客户端格式写出去：
+//   - 入口拒绝（被标记对话）：完整合成响应（流式/非流式）
+//   - 流式接管（审核壳首块拦截）：完整合成流式响应
+//   - 流式尾部追加：回复结束后附加提示块
+
+func moderationFormatOf(info *relaycommon.RelayInfo) string {
+	if info == nil {
+		return "openai"
+	}
+	switch info.RelayFormat {
+	case relaytypes.RelayFormatClaude:
+		return "claude"
+	case relaytypes.RelayFormatGemini:
+		return "gemini"
+	default:
+		return "openai"
+	}
+}
+
+// ModerationWrapDataHandler 流式审核壳：第一个数据块转发前先查异步判定，
+// 已命中则接管（合成提示响应并停止读上游）。未命中原样透传。
+func ModerationWrapDataHandler(c *gin.Context, info *relaycommon.RelayInfo, inner func(string, *StreamResult)) func(string, *StreamResult) {
+	st := moderation.StateFrom(c)
+	if st == nil || st.Refused {
+		return inner
+	}
+	format := moderationFormatOf(info)
+	modelName := ""
+	if info != nil {
+		modelName = info.OriginModelName
+	}
+	return func(data string, sr *StreamResult) {
+		if st.TakenOver.Load() {
+			return // 已接管，丢弃上游残余数据
+		}
+		if !st.SawContent.Load() {
+			if v := st.GetVerdict(); v != nil {
+				st.TakenOver.Store(true)
+				moderationSynthesizeStream(c, format, st.NoticeTextOf(v), modelName)
+				sr.Stop(nil)
+				return
+			}
+			st.SawContent.Store(true)
+		}
+		moderationTrackClaudeBlock(st, data)
+		inner(data, sr)
+	}
+}
+
+// ModerationTakenOver 流式响应是否已被审核壳完整接管（含终结帧）。
+func ModerationTakenOver(c *gin.Context) bool {
+	st := moderation.StateFrom(c)
+	return st != nil && st.Taken()
+}
+
+// ModerationTailGate 流式收尾判定。返回 true 表示已接管（合成响应已写完，
+// 调用方应立即返回零 usage，跳过所有后续收尾写入）；返回 false 表示可正常收尾
+// （若判定已出且已有内容转发，则已先行追加了提示块）。
+func ModerationTailGate(c *gin.Context, info *relaycommon.RelayInfo) bool {
+	st := moderation.StateFrom(c)
+	if st == nil || st.Refused {
+		return false
+	}
+	if st.TakenOver.Load() {
+		return true
+	}
+	format := moderationFormatOf(info)
+	modelName := ""
+	if info != nil {
+		modelName = info.OriginModelName
+	}
+	v := st.GetVerdict()
+	if v == nil {
+		grace := time.Duration(st.GraceSec) * time.Second
+		if grace <= 0 {
+			grace = 3 * time.Second
+		}
+		select {
+		case nv := <-st.VerdictC:
+			v = nv
+		case <-time.After(grace):
+		}
+	}
+	if v == nil {
+		return false // 判定未出：正常收尾，标记随后异步生效（下一请求拦截）
+	}
+	if !st.SawContent.Load() {
+		// 上游没吐任何内容就结束了：直接合成提示响应
+		st.TakenOver.Store(true)
+		moderationSynthesizeStream(c, format, st.NoticeTextOf(v), modelName)
+		return true
+	}
+	moderationAppendNotice(c, format, st, st.NoticeTextOf(v))
+	return false
+}
+
+// ==================== 写出实现 ====================
+
+func moderationWriteOpenAIChunk(c *gin.Context, chunk map[string]any) {
+	_ = StringData(c, string(mustJSON(chunk)))
+}
+
+func moderationClaudeEvent(c *gin.Context, obj map[string]any) {
+	eventType, _ := obj["type"].(string)
+	c.Render(-1, common.CustomEvent{Data: "event: " + eventType + "\n"})
+	c.Render(-1, common.CustomEvent{Data: "data: " + string(mustJSON(obj))})
+	_ = FlushWriter(c)
+}
+
+func mustJSON(v any) []byte {
+	b, err := common.Marshal(v)
+	if err != nil {
+		return []byte("{}")
+	}
+	return b
+}
+
+func moderationSynthesizeStream(c *gin.Context, format string, notice string, modelName string) {
+	SetEventStreamHeaders(c)
+	switch format {
+	case "claude":
+		moderationClaudeEvent(c, map[string]any{
+			"type": "message_start",
+			"message": map[string]any{
+				"id": moderation.ResponseID("msg"), "type": "message", "role": "assistant",
+				"model": modelName, "content": []any{},
+				"usage": map[string]any{"input_tokens": 0, "output_tokens": 0},
+			},
+		})
+		moderationClaudeEvent(c, map[string]any{
+			"type": "content_block_start", "index": 0,
+			"content_block": map[string]any{"type": "text", "text": ""},
+		})
+		moderationClaudeEvent(c, map[string]any{
+			"type": "content_block_delta", "index": 0,
+			"delta": map[string]any{"type": "text_delta", "text": notice},
+		})
+		moderationClaudeEvent(c, map[string]any{"type": "content_block_stop", "index": 0})
+		moderationClaudeEvent(c, map[string]any{
+			"type":  "message_delta",
+			"delta": map[string]any{"stop_reason": "end_turn", "stop_sequence": nil},
+			"usage": map[string]any{"output_tokens": len(notice) / 4},
+		})
+		moderationClaudeEvent(c, map[string]any{"type": "message_stop"})
+	case "gemini":
+		moderationWriteOpenAIChunk(c, map[string]any{
+			"candidates": []any{map[string]any{
+				"content":      map[string]any{"parts": []any{map[string]any{"text": notice}}, "role": "model"},
+				"index":        0,
+				"finishReason": "STOP",
+			}},
+			"model": modelName,
+		})
+	default:
+		id := moderation.ResponseID("chatcmpl")
+		now := time.Now().Unix()
+		moderationWriteOpenAIChunk(c, map[string]any{
+			"id": id, "object": "chat.completion.chunk", "created": now, "model": modelName,
+			"choices": []any{map[string]any{
+				"index":         0,
+				"delta":         map[string]any{"role": "assistant", "content": notice},
+				"finish_reason": nil,
+			}},
+		})
+		moderationWriteOpenAIChunk(c, map[string]any{
+			"id": id, "object": "chat.completion.chunk", "created": now, "model": modelName,
+			"choices": []any{map[string]any{
+				"index":         0,
+				"delta":         map[string]any{},
+				"finish_reason": "stop",
+			}},
+		})
+		Done(c)
+	}
+}
+
+func moderationAppendNotice(c *gin.Context, format string, st *moderation.RequestState, notice string) {
+	switch format {
+	case "claude":
+		idx := st.NextClaudeBlockIndex()
+		moderationClaudeEvent(c, map[string]any{
+			"type": "content_block_start", "index": idx,
+			"content_block": map[string]any{"type": "text", "text": ""},
+		})
+		moderationClaudeEvent(c, map[string]any{
+			"type": "content_block_delta", "index": idx,
+			"delta": map[string]any{"type": "text_delta", "text": notice},
+		})
+		moderationClaudeEvent(c, map[string]any{"type": "content_block_stop", "index": idx})
+	case "gemini":
+		moderationWriteOpenAIChunk(c, map[string]any{
+			"candidates": []any{map[string]any{
+				"content": map[string]any{"parts": []any{map[string]any{"text": notice}}, "role": "model"},
+				"index":   0,
+			}},
+		})
+	default:
+		moderationWriteOpenAIChunk(c, map[string]any{
+			"choices": []any{map[string]any{
+				"index":         0,
+				"delta":         map[string]any{"content": "\n\n" + notice},
+				"finish_reason": nil,
+			}},
+		})
+	}
+}
+
+// ModerationRefuseResponse 入口拒绝（被标记对话）：按客户端格式合成完整响应。
+func ModerationRefuseResponse(c *gin.Context, st *moderation.RequestState, isStream bool, modelName string) {
+	if st == nil {
+		return
+	}
+	format := st.Format
+	notice := st.Notice
+	if isStream {
+		moderationSynthesizeStream(c, format, notice, modelName)
+		return
+	}
+	switch format {
+	case "claude":
+		c.JSON(200, map[string]any{
+			"id": moderation.ResponseID("msg"), "type": "message", "role": "assistant",
+			"model": modelName,
+			"content": []any{map[string]any{"type": "text", "text": notice}},
+			"stop_reason": "end_turn", "stop_sequence": nil,
+			"usage": map[string]any{"input_tokens": 0, "output_tokens": 0},
+		})
+	case "gemini":
+		c.JSON(200, map[string]any{
+			"candidates": []any{map[string]any{
+				"content":      map[string]any{"parts": []any{map[string]any{"text": notice}}, "role": "model"},
+				"index":        0,
+				"finishReason": "STOP",
+			}},
+			"model": modelName,
+			"usageMetadata": map[string]any{"promptTokenCount": 0, "candidatesTokenCount": 0, "totalTokenCount": 0},
+		})
+	default:
+		c.JSON(200, map[string]any{
+			"id": moderation.ResponseID("chatcmpl"), "object": "chat.completion",
+			"created": time.Now().Unix(), "model": modelName,
+			"choices": []any{map[string]any{
+				"index": 0,
+				"message": map[string]any{"role": "assistant", "content": notice},
+				"finish_reason": "stop",
+			}},
+			"usage": map[string]any{"prompt_tokens": 0, "completion_tokens": 0, "total_tokens": 0},
+		})
+	}
+}
+
+// moderationTrackClaudeBlock 跟踪 claude 原生事件里的最大 content_block index，
+// 供追加提示块时选新块号。
+func moderationTrackClaudeBlock(st *moderation.RequestState, data string) {
+	if len(data) < 20 || data[0] != '{' {
+		return
+	}
+	var probe struct {
+		Type  string `json:"type"`
+		Index *int   `json:"index"`
+	}
+	if err := common.Unmarshal(common.StringToByteSlice(data), &probe); err != nil {
+		return
+	}
+	if probe.Type == "content_block_start" && probe.Index != nil && *probe.Index > st.ClaudeBlockIndexHint() {
+		st.SetClaudeBlockIndex(*probe.Index)
+	}
+}
+
